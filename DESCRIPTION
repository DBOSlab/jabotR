Package: jabotR
Type: Package
Title: An R Package for Exploring JABOT Online Plant Specimen Collections
Version: 1.0.0
Authors@R:
    c(
      person(given = "Domingos",
             family = "Cardoso",
             role = c("aut", "cre", "cph"),
             email = "domingoscardoso@jbrj.gov.br",
             comment = c(ORCID = "0000-0001-7072-2656"))
